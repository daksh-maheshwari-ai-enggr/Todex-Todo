generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bots         Bot[]    @relation("UserBots")
  chats       Chat[]    @relation("UserChats")
  messages    Message[] @relation("UserMessages")

  @@index([email])
}

model Bot {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserBots", fields: [userId], references: [id])
  name          String   @db.VarChar(50)
  avatar        String   @db.VarChar(100)  // Will store avatar seed/URL
  job           String   @db.VarChar(100)
  instructions  String?  @db.VarChar(4000)
  sandboxId     String?  // Nullable for future Daytona integration
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chats        Chat[]   @relation("BotChats")

  @@index([userId])
  @@index([id])
}

model Chat {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserChats", fields: [userId], references: [id])
  botId       String?
  bot         Bot?      @relation("BotChats", fields: [botId], references: [id])
  title       String    @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[] @relation("ChatMessages")

  @@index([userId])
  @@index([botId])
}

model Message {
  id          String    @id @default(cuid())
  chatId      String
  chat        Chat      @relation("ChatMessages", fields: [chatId], references: [id])
  senderId    String
  sender      User      @relation("UserMessages", fields: [senderId], references: [id])
  role        String    @enum(["user", "assistant", "tool"])
  content     String    @db.VarChar(4000)
  createdAt   DateTime  @default(now())
  isRead      Boolean   @default(false)

  @@index([chatId])
  @@index([senderId])
}