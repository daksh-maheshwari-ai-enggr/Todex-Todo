generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bots         Bot[]    @relation("UserBots")
  chats       Chat[]    @relation("UserChats")
  messages    Message[] @relation("UserMessages")
  todos       Todo[]    @relation("UserTodos")
  toolExecutions ToolExecution[] @relation("UserToolExecutions")
  handoffs    Handoff[]  @relation("UserHandoffs")
  aiJobs      AiJob[]  @relation("UserAiJobs")
  approvals   ApprovalRequest[] @relation("UserApprovals")
  scheduledTasks ScheduledTask[] @relation("UserScheduledTasks")

  @@index([email])
}

model Bot {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserBots", fields: [userId], references: [id])
  name          String   @db.VarChar(50)
  avatar        String   @db.VarChar(100)  // Will store avatar seed/URL
  job           String   @db.VarChar(100)
  instructions  String?  @db.VarChar(4000)
  sandboxId     String?  // Nullable for future Daytona integration
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chats        Chat[]   @relation("BotChats")
  messages     Message[] @relation("BotMessages")
  chatParticipants ChatParticipant[] @relation("BotChatParticipants")
  handoffsFrom Handoff[] @relation("HandoffFrom")
  handoffsTo   Handoff[] @relation("HandoffTo")
  aiJobs       AiJob[]  @relation("BotAiJobs")
  approvals    ApprovalRequest[] @relation("BotApprovals")
  scheduledTasks ScheduledTask[] @relation("BotScheduledTasks")

  @@index([userId])
  @@index([id])
}

model Chat {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserChats", fields: [userId], references: [id], onDelete: Cascade)
  botId       String?
  bot         Bot?      @relation("BotChats", fields: [botId], references: [id], onDelete: SetNull)
  title       String    @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[] @relation("ChatMessages")
  toolExecutions ToolExecution[] @relation("ChatToolExecutions")
  participants ChatParticipant[] @relation("ChatParticipants")
  handoffs    Handoff[] @relation("ChatHandoffs")
  aiJobs      AiJob[]   @relation("ChatAiJobs")
  approvals   ApprovalRequest[] @relation("ChatApprovals")
  scheduledTasks ScheduledTask[] @relation("ChatScheduledTasks")

  @@index([userId])
  @@index([botId])
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model Message {
  id          String    @id @default(cuid())
  chatId      String
  chat        Chat      @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)
  role        MessageRole
  content     String    @db.VarChar(4000)
  // Which AI teammate produced an assistant message. Null for user messages
  // and for legacy/assistant messages that predate teammate attribution.
  botId       String?
  bot         Bot?      @relation("BotMessages", fields: [botId], references: [id], onDelete: SetNull)
  // TOOL messages only: the model tool-call id this result answers. A resumed
  // or retried run rebuilds the assistant tool_call/result pair from it, which
  // is the shape providers require. Null for USER/ASSISTANT rows (Postgres
  // treats nulls as distinct, so only real tool results can collide).
  toolCallId  String?   @db.VarChar(200)
  createdAt   DateTime  @default(now())
  isRead      Boolean   @default(false)

  @@unique([chatId, toolCallId])
  @@index([chatId])
  @@index([senderId])
  @@index([botId])
}

model Todo {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserTodos", fields: [userId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(2000)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

enum ToolExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ToolExecution {
  id          String              @id @default(cuid())
  chatId      String
  chat        Chat                @relation("ChatToolExecutions", fields: [chatId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation("UserToolExecutions", fields: [userId], references: [id], onDelete: Cascade)
  // The background job this execution belongs to, when it ran inside one. Null
  // for synchronous chat turns. Used to show a job's own step timeline instead
  // of every execution in the chat.
  aiJobId     String?
  aiJob       AiJob?              @relation("JobToolExecutions", fields: [aiJobId], references: [id], onDelete: SetNull)
  toolName    String              @db.VarChar(100)
  toolCallId  String?             @db.VarChar(200)
  args        String?             @db.VarChar(4000)
  status      ToolExecutionStatus @default(PENDING)
  result      String?             @db.VarChar(4000)
  error       String?             @db.VarChar(2000)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  createdAt   DateTime            @default(now())

  @@unique([chatId, toolCallId])
  @@index([chatId])
  @@index([userId])
  @@index([aiJobId])
}

model ChatParticipant {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation("ChatParticipants", fields: [chatId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation("BotChatParticipants", fields: [botId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([chatId, botId])
  @@index([chatId])
  @@index([botId])
}

enum HandoffStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model Handoff {
  id          String        @id @default(cuid())
  chatId      String
  chat        Chat          @relation("ChatHandoffs", fields: [chatId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("UserHandoffs", fields: [userId], references: [id], onDelete: Cascade)
  fromBotId   String
  fromBot     Bot           @relation("HandoffFrom", fields: [fromBotId], references: [id], onDelete: Cascade)
  toBotId     String
  toBot       Bot           @relation("HandoffTo", fields: [toBotId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Handoff?      @relation("HandoffChain", fields: [parentId], references: [id], onDelete: SetNull)
  children    Handoff[]     @relation("HandoffChain")
  depth       Int           @default(0)
  task        String        @db.VarChar(2000)
  status      HandoffStatus @default(PENDING)
  result      String?       @db.VarChar(4000)
  error       String?       @db.VarChar(2000)
  createdAt   DateTime      @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([chatId])
  @@index([userId])
  @@index([fromBotId])
  @@index([toBotId])
}

// Durable background AI job metadata. A job is the application's own record of
// a long-running teammate turn dispatched to Trigger.dev; Trigger.dev remains
// the execution layer, this table is the source of truth for app-visible
// lifecycle, ownership and bounded results.
enum AiJobStatus {
  QUEUED
  RUNNING
  WAITING_FOR_USER
  SUCCEEDED
  FAILED
  CANCELLED
}

model AiJob {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation("UserAiJobs", fields: [userId], references: [id], onDelete: Cascade)
  chatId             String
  chat               Chat        @relation("ChatAiJobs", fields: [chatId], references: [id], onDelete: Cascade)
  botId              String
  bot                Bot         @relation("BotAiJobs", fields: [botId], references: [id], onDelete: Cascade)
  status             AiJobStatus @default(QUEUED)
  // Bounded, validated copy of the user request. This is the only task input
  // material stored; the Trigger.dev payload carries just the job id.
  message            String      @db.VarChar(4000)
  // Trigger.dev run identifier once dispatch succeeded. Null means the job was
  // never confirmed dispatched.
  runId              String?     @db.VarChar(200)
  // Latest raw Trigger.dev run status, kept for reconciliation/observability.
  runStatus          String?     @db.VarChar(40)
  // Optional client-supplied key used to deduplicate repeated start requests.
  idempotencyKey     String?     @db.VarChar(200)
  attemptCount       Int         @default(0)
  maxAttempts        Int         @default(3)
  // Reused across attempts so a retry never duplicates the user message. The
  // Message rows themselves remain the authoritative chat record.
  userMessageId      String?     @db.VarChar(200)
  assistantMessageId String?     @db.VarChar(200)
  // Human-in-the-loop pause bookkeeping: the approval that paused this run and
  // when it started waiting. Null while the run is executing normally.
  lastApprovalId     String?     @db.VarChar(200)
  waitSince          DateTime?
  // Number of completed tool rounds for this job so far. Counted across every
  // attempt and resume of the job, because the step budget (config.job.maxSteps)
  // bounds the job's whole life, not one run.
  stepCount          Int         @default(0)
  approvals          ApprovalRequest[] @relation("JobApprovals")
  toolExecutions     ToolExecution[]   @relation("JobToolExecutions")
  // Bounded success result / sanitized failure message (never a stack trace).
  result             String?     @db.VarChar(4000)
  error              String?     @db.VarChar(2000)
  createdAt          DateTime    @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime    @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([chatId])
  @@index([botId])
  @@index([status])
}

// A human-in-the-loop pause raised by a running agent turn.
//
// The agent stops its tool loop when one of these exists in PENDING state and
// the run is resumed from here once the owner responds: a QUESTION approval
// carries the ask_user tool's question/options and stores the answer as the
// deferred tool result; an ACTION approval carries a deferred sensitive tool
// call (toolName/args/toolCallId) that runs only after explicit approval.
enum ApprovalKind {
  QUESTION
  ACTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model ApprovalRequest {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation("UserApprovals", fields: [userId], references: [id], onDelete: Cascade)
  chatId    String
  chat      Chat          @relation("ChatApprovals", fields: [chatId], references: [id], onDelete: Cascade)
  botId     String?
  bot       Bot?          @relation("BotApprovals", fields: [botId], references: [id], onDelete: SetNull)
  // The paused run. Null for a synchronous respond turn (no job row exists).
  aiJobId   String?
  aiJob     AiJob?        @relation("JobApprovals", fields: [aiJobId], references: [id], onDelete: SetNull)
  kind      ApprovalKind
  // What the user sees in the approval card.
  question  String        @db.VarChar(2000)
  options   String?       @db.VarChar(2000)
  // ACTION approvals: the deferred tool call, resumed only after approval.
  toolName  String?       @db.VarChar(100)
  toolCallId String?      @db.VarChar(200)
  args      String?       @db.VarChar(4000)
  // Display links: the assistant message showing the question, and the user's
  // answer message (excluded from the resumed model context because the answer
  // is re-fed as the deferred tool result instead).
  assistantMessageId String? @db.VarChar(200)
  responseMessageId  String? @db.VarChar(200)
  status    ApprovalStatus @default(PENDING)
  response  String?       @db.VarChar(4000)
  createdAt DateTime      @default(now())
  resolvedAt DateTime?
  expiresAt DateTime?

  @@index([userId, status])
  @@index([chatId, status])
  @@index([aiJobId])
}

// A scheduled / proactive teammate run (ROADMAP.md Phase D).
//
// Deliberately a different lifecycle from AiJob: a task is a standing
// instruction that produces runs over time — one (runAt) or many
// (intervalMinutes) — and owns its own schedule bookkeeping. Every due slot
// dispatches the same AI_JOB_TASK_ID as a manual background run, so pausing for
// an approval, step budgets and crash-safe resume are inherited unchanged.
enum ScheduledTaskStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model ScheduledTask {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation("UserScheduledTasks", fields: [userId], references: [id], onDelete: Cascade)
  botId           String
  bot             Bot                 @relation("BotScheduledTasks", fields: [botId], references: [id], onDelete: Cascade)
  chatId          String
  chat            Chat                @relation("ChatScheduledTasks", fields: [chatId], references: [id], onDelete: Cascade)
  // The instruction handed to the teammate, bounded like any other request.
  goal            String              @db.VarChar(4000)
  // One-shot: the instant the run is due. Null for a repeating task.
  runAt           DateTime?
  // Repeating: minutes between runs (1440 = daily). Null for a one-shot.
  intervalMinutes Int?
  // When the next run is due. Doubles as the run's idempotency slot, so a sweep
  // that fires twice can never dispatch the same slot twice.
  nextRunAt       DateTime?
  status          ScheduledTaskStatus @default(ACTIVE)
  lastRunAt       DateTime?
  // The job the most recent run dispatched, so the UI can link to its result.
  lastJobId       String?             @db.VarChar(200)
  // Why the last dispatch attempt failed. Kept visible instead of silently
  // skipping a run; the slot stays due so the next sweep retries it.
  lastError       String?             @db.VarChar(2000)
  runCount        Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, status])
  @@index([status, nextRunAt])
}