generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bots         Bot[]    @relation("UserBots")
  chats       Chat[]    @relation("UserChats")
  messages    Message[] @relation("UserMessages")
  todos       Todo[]    @relation("UserTodos")
  toolExecutions ToolExecution[] @relation("UserToolExecutions")

  @@index([email])
}

model Bot {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserBots", fields: [userId], references: [id])
  name          String   @db.VarChar(50)
  avatar        String   @db.VarChar(100)  // Will store avatar seed/URL
  job           String   @db.VarChar(100)
  instructions  String?  @db.VarChar(4000)
  sandboxId     String?  // Nullable for future Daytona integration
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chats        Chat[]   @relation("BotChats")

  @@index([userId])
  @@index([id])
}

model Chat {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserChats", fields: [userId], references: [id], onDelete: Cascade)
  botId       String?
  bot         Bot?      @relation("BotChats", fields: [botId], references: [id], onDelete: SetNull)
  title       String    @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[] @relation("ChatMessages")
  toolExecutions ToolExecution[] @relation("ChatToolExecutions")

  @@index([userId])
  @@index([botId])
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model Message {
  id          String    @id @default(cuid())
  chatId      String
  chat        Chat      @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)
  role        MessageRole
  content     String    @db.VarChar(4000)
  createdAt   DateTime  @default(now())
  isRead      Boolean   @default(false)

  @@index([chatId])
  @@index([senderId])
}

model Todo {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserTodos", fields: [userId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(2000)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

enum ToolExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ToolExecution {
  id          String              @id @default(cuid())
  chatId      String
  chat        Chat                @relation("ChatToolExecutions", fields: [chatId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation("UserToolExecutions", fields: [userId], references: [id], onDelete: Cascade)
  toolName    String              @db.VarChar(100)
  toolCallId  String?             @db.VarChar(200)
  args        String?             @db.VarChar(4000)
  status      ToolExecutionStatus @default(PENDING)
  result      String?             @db.VarChar(4000)
  error       String?             @db.VarChar(2000)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  createdAt   DateTime            @default(now())

  @@unique([chatId, toolCallId])
  @@index([chatId])
  @@index([userId])
}