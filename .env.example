# Database
DATABASE_URL="postgres://user:password@localhost:5432/aitteammates"

# JWT
JWT_SECRET="change-me-in-production"

# Server
PORT=3000

# OpenRouter
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-3.5-turbo"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TIMEOUT_MS=30000

# Conversation memory
MEMORY_MAX_HISTORY_MESSAGES=30

# Group chats and teammate handoffs
GROUP_CHAT_MAX_PARTICIPANTS=10
HANDOFF_MAX_DEPTH=3
HANDOFF_MAX_EXECUTIONS=6
HANDOFF_TIMEOUT_MS=60000
HANDOFF_MAX_TASK_LENGTH=2000

# Daytona sandboxes (optional; sandbox tools are unavailable without these)
DAYTONA_API_KEY="your-daytona-api-key"
DAYTONA_API_URL="https://app.daytona.io/api"
DAYTONA_TARGET="us"
DAYTONA_SANDBOX_LANGUAGE=python
DAYTONA_CREATE_TIMEOUT_SEC=60
DAYTONA_EXEC_TIMEOUT_SEC=30
DAYTONA_COMMAND_MAX_LENGTH=2000
DAYTONA_PATH_MAX_LENGTH=1024
DAYTONA_OUTPUT_MAX_BYTES=8000
DAYTONA_FILE_READ_MAX_BYTES=50000
DAYTONA_FILE_WRITE_MAX_BYTES=50000
DAYTONA_LIST_MAX_ENTRIES=200
DAYTONA_WORKSPACE_DIR=workspace